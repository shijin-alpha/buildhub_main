# FastAPI ML Service Configuration

# Service Configuration
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Model Configuration
MODELS_DIR=../ml/models

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=*

# Request Timeout (seconds)
REQUEST_TIMEOUT=30

# Auto Reload (development only)
AUTO_RELOAD=false
